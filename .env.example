# Copy to .env (compose root) or backend/.env (local uvicorn) and fill in.

# "mock" works offline with canned questions; "anthropic" uses Claude for real interviews and feedback
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Local dev without Postgres:
# DATABASE_URL=sqlite+aiosqlite:///./dev.db

# Optional: run sandboxes under gVisor if installed on the Docker host
# SANDBOX_RUNTIME=runsc

# Sandbox execution: "docker" = in the API process (local dev), "queue" = via Redis to the arq worker
# SANDBOX_BACKEND=docker
# REDIS_URL=redis://localhost:6379

# "production" refuses to start with a weak JWT secret or without the queue
# ENVIRONMENT=development

# Languages offered by the judge (each needs a one-time image build). Trim to save disk:
# SANDBOX_LANGUAGES=["python","javascript","java","cpp","go"]

# Social sign-in (see README "Social sign-in setup"). A button appears only when both id and secret are set.
# PUBLIC_URL=http://localhost:3080
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Email: "console" (log only), "smtp", or "none". docker-compose defaults to smtp -> Mailpit
# (local inbox at http://localhost:8025). For real delivery, any SMTP provider works, e.g.:
# EMAIL_BACKEND=smtp
# EMAIL_FROM=PrepForge <no-reply@yourdomain.com>
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Pre-started sandbox containers per language (faster runs; ~1-10 MB RAM each). 0 disables.
# SANDBOX_WARM_POOL=1

# PostgreSQL row-level security: the non-superuser role each transaction switches to.
# Leave the default unless your DATABASE_URL user can't create roles (then connect as a non-superuser).
# DB_APP_ROLE=prepforge_app

# ---- Production (docker-compose.prod.yml, see docs/DEPLOY.md) ----
# DOMAIN=prep.example.com
# POSTGRES_PASSWORD=

# Operations: JSON logs, a token for /api/metrics, Sentry error tracking.
# LOG_FORMAT=json
# METRICS_TOKEN=
# SENTRY_DSN=
